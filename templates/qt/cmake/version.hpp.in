#pragma once

// Generated from cmake/version.hpp.in. Do not edit.
// The version is declared once, in project(... VERSION ...), and flows from
// there into this header and into whatever --version prints. Bumping it in one
// place is the whole point.

#define MYAPP_VERSION_STRING "@PROJECT_VERSION@"

namespace myapp {

/// The version this program was built as, as a literal string.
inline constexpr const char* version() noexcept
{
    return MYAPP_VERSION_STRING;
}

}  // namespace myapp
